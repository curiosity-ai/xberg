{
	"id": "code_shebang_detection",
	"category": "code",
	"description": "Test language detection from shebang line via bytes input",
	"docs": {
		"topic": "code",
		"title": "Test language detection from shebang line via bytes input",
		"description": "Test language detection from shebang line via bytes input",
		"side_effects": "server"
	},
	"tags": ["code", "shebang", "tree-sitter"],
	"call": "extract",
	"input": {
		"mock_responses": [
			{
				"path": "/code/script.sh",
				"status_code": 200,
				"headers": {
					"content-type": "application/octet-stream"
				},
				"body_file": "../test_documents/code/script.sh"
			}
		],
		"extract_input": {
			"kind": "uri",
			"uri": "$mock_url/code/script.sh",
			"mime_type": "text/x-source-code"
		}
	},
	"assertions": [
		{
			"type": "equals",
			"field": "results[0].mime_type",
			"value": "text/x-source-code"
		},
		{
			"type": "min_length",
			"field": "results[0].content",
			"value": 10
		},
		{
			"type": "contains_all",
			"field": "results[0].content",
			"values": ["build", "clean"]
		}
	]
}
